{
  "name": "archive-rvw",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:vite": "vite",
    "dev:upload": "wrangler dev --config workers/r2-upload/wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:upload": "wrangler deploy --config workers/r2-upload/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.92.0"
  }
}
