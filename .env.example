# Copy to `.env` if needed (repo includes `.env` for local dev).
#
# Local: `/api` is proxied to the upload Worker (see vite.config.ts).
# Production: your deployed Worker URL, e.g. https://archive-rvw-upload.<account>.workers.dev
VITE_R2_UPLOAD_URL=/api
#
# Optional — must match Worker secret `UPLOAD_SECRET` when set.
VITE_R2_UPLOAD_TOKEN=

# Admin page password (required in production builds).
# Local dev defaults to "archive" when unset.
VITE_ADMIN_PASSWORD=

# Optional — override Wrangler dev URL for the Vite proxy (default http://127.0.0.1:8787)
# VITE_UPLOAD_PROXY_TARGET=http://127.0.0.1:8787
